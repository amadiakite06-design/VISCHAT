# This .gitignore is appropriate for repositories deployed to GitHub Pages and using
# a Gemfile as specified at https://github.com/github/pages-gem#conventional

# Basic Jekyll gitignores (synchronize to Jekyll.gitignore)
_site/
.sass-cache/
// API Proxy — Auto-generated by Snapp. DO NOT EDIT.
//
// Gizli API anahtarlarını istemciye indirmeden dış servislere istek atmanı sağlar.
// keys.ts'teki gizli anahtarlar gerçek değeri DEĞİL "{{KEY_NAME}}" yer tutucusunu taşır;
// yer tutucuyu Snapp backend'i sunucu tarafında gerçek değerle değiştirir.
//
// Kullanım:
//   import { proxyPost } from './api-proxy';
//   import { ANTHROPIC_API_KEY } from './keys';
//
//   const data = await proxyPost(
//     'https://api.anthropic.com/v1/messages',
//     { model: 'claude-sonnet-4-6', max_tokens: 1024, messages },
//     { 'x-api-key': ANTHROPIC_API_KEY, 'anthropic-version': '2023-06-01' }
//   );
//
// ❌ Gizli bir anahtarla doğrudan fetch ETME — yer tutucu gider, hedef API 401 döner.
//
// Not: her anahtar yalnız AİT OLDUĞU API'ye gönderilebilir. Başka bir hosta göndermeye
// çalışırsan sunucu 403 KEY_HOST_NOT_ALLOWED döner.

const PROXY_URL = "https://snapp-backend.yellowdesert-4995d402.westeurope.azurecontainerapps.io/api/v3/proxy";
const APP_ID = "1794423075463-armeo9";
const PROXY_TOKEN = "{{PROXY_TOKEN}}";
const THROW_ON_API_ERROR = false;

export interface ProxyRequestConfig {
  /** Hedef API adresi (mutlak URL). */
  url: string;
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';
  /** Başlıklar. Gizli anahtar için {{KEY_NAME}} yer tutucusunu kullan. */
  headers?: Record<string, string>;
  body?: any;
  params?: Record<string, any>;
}

export class ProxyError extends Error {
  code: string;
  status: number;
  /** For UPSTREAM_ERROR: the API's own error body. */
  data?: any;
  constructor(message: string, code: string, status: number, data?: any) {
    super(message);
    this.name = 'ProxyError';
    this.code = code;
    this.status = status;
    this.data = data;
  }
}

function apiErrorMessage(data: any, status: number): string {
  const e = data && typeof data === 'object' ? data.error : undefined;
  const text = typeof e === 'string' ? e
    : e && typeof e.message === 'string' ? e.message
    : data && typeof data.message === 'string' ? data.message
    : typeof data === 'string' && data.length < 300 ? data
    : '';
  return text ? `The API answered ${status}: ${text}` : `The API answered ${status}`;
}

export async function proxyFetch<T = any>(config: ProxyRequestConfig): Promise<T> {
  let response: Response;
  try {
    response = await fetch(PROXY_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-snapp-proxy-token': PROXY_TOKEN,
      },
      body: JSON.stringify({ app_id: APP_ID, proxy_token: PROXY_TOKEN, request: config }),
    });
  } catch {
    throw new ProxyError('Network error: could not reach the Snapp proxy', 'NETWORK_ERROR', 0);
  }

  const result = await response.json().catch(() => ({} as any));

  if (!response.ok) {
    throw new ProxyError(
      result.error || 'Proxy request failed',
      result.code || 'UNKNOWN_ERROR',
      response.status
    );
  }

  if (THROW_ON_API_ERROR && typeof result.status === 'number' && result.status >= 400) {
    throw new ProxyError(apiErrorMessage(result.data, result.status), 'UPSTREAM_ERROR', result.status, result.data);
  }

  return result.data as T;
}

export async function proxyGet<T = any>(
  url: string,
  params?: Record<string, any>,
  headers?: Record<string, string>
): Promise<T> {
  return proxyFetch<T>({ url, method: 'GET', params, headers });
}

export async function proxyPost<T = any>(
  url: string,
  body?: any,
  headers?: Record<string, string>
): Promise<T> {
  return proxyFetch<T>({ url, method: 'POST', body, headers });
}

export async function proxyPut<T = any>(
  url: string,
  body?: any,
  headers?: Record<string, string>
): Promise<T> {
  return proxyFetch<T>({ url, method: 'PUT', body, headers });
}

export async function proxyPatch<T = any>(
  url: string,
  body?: any,
  headers?: Record<string, string>
): Promise<T> {
  return proxyFetch<T>({ url, method: 'PATCH', body, headers });
}

export async function proxyDelete<T = any>(
  url: string,
  headers?: Record<string, string>
): Promise<T> {
  return proxyFetch<T>({ url, method: 'DELETE', headers });
}


# Specific ignore for GitHub Pages
# GitHub Pages will always use its own deployed version of pages-gem
# This means GitHub Pages will NOT use your Gemfile.lock and therefore it is
# counterproductive to check this file into the repository.
# Details at https://github.com/github/pages-gem/issues/768
Gemfile.lock
